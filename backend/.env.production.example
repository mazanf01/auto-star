# ─── Backend Production Environment Variables ──────────────
# Copy values & set di Koyeb Dashboard → Service → Settings → Environment

# Server
PORT=3001
NODE_ENV=production

# JWT (generate: openssl rand -hex 32)
JWT_SECRET=<replace-with-random-64-hex-chars>
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Encryption for STAR ASN credentials (generate: openssl rand -hex 32)
# ⚠️ Must match the key used during development, or existing credentials become undecryptable!
ENCRYPTION_KEY=<replace-with-32-byte-hex-key>

# CORS — frontend URL (Cloudflare Pages)
CORS_ORIGIN=https://star-asn-web.pages.dev

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Jakarta

# Telegram (optional, for presensi notifications)
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_DEFAULT_CHAT_ID=<chat-id>
